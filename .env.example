# Copy this file to .env and fill in real values. Never commit .env.

# --- Django core ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- documark environment ---
# "development" or "production". In production, DOCUMARK_FERNET_KEY is
# required (the app refuses to start without it) and DJANGO_DEBUG should be False.
DOCUMARK_ENV=development

# Generate with: python scripts/generate_fernet_key.py
DOCUMARK_FERNET_KEY=

# --- Database (PostgreSQL) ---
# POSTGRES_HOST/PORT point at the `postgres` service from docker-compose.yml.
# For a non-Docker/local run, point them at your own Postgres instance instead.
POSTGRES_DB=documark
POSTGRES_USER=documark
POSTGRES_PASSWORD=documark
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Uploads / conversion ---
DOCUMARK_MAX_UPLOAD_MB=50
# How long the converted .md file stays downloadable (2 hours). After this,
# the file is deleted and the entry shows as "expired" — the history record
# itself stays until DOCUMARK_HISTORY_RETENTION_SECONDS.
DOCUMARK_OUTPUT_TTL_SECONDS=7200
# How long a history record (metadata only, any status) is kept before
# being purged entirely (24 hours). Must be >= DOCUMARK_OUTPUT_TTL_SECONDS.
DOCUMARK_HISTORY_RETENTION_SECONDS=86400
# Hard ceiling (seconds) on a single conversion; a slower/hung document is
# cancelled and recorded as a failed conversion instead of crashing a
# Gunicorn worker. Keep GUNICORN_TIMEOUT larger than this.
DOCUMARK_CONVERSION_TIMEOUT_SECONDS=240

# --- Gunicorn (production server) ---
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=300

# --- Celery (background conversions) + Redis ---
# Redis is only a broker/cache here — no business data lives in it.
CELERY_BROKER_URL=redis://redis:6379/0
DOCUMARK_REDIS_CACHE_URL=redis://redis:6379/1
CELERY_WORKER_CONCURRENCY=2
# How often Celery Beat runs cleanup_expired_task (seconds).
DOCUMARK_CLEANUP_INTERVAL_SECONDS=300

# --- Sessions ---
DOCUMARK_SESSION_IDLE_SECONDS=1800

# --- Initial admin (created by the create_initial_admin management command) ---
DOCUMARK_INITIAL_ADMIN_USERNAME=admin
DOCUMARK_INITIAL_ADMIN_PASSWORD=ChangeMe123!
DOCUMARK_INITIAL_ADMIN_EMAIL=admin@example.local

# --- HTTPS hardening (enable once served behind TLS) ---
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
